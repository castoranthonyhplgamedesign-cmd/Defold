            float u_xlat16_37;\nmediump float u_xlat16_38;\nvoid main()\n{\n    u_xlat10_0
            = texture2D(_MainTex, vs_TEXCOORD0.xy);\n    u_xlat16_1 = u_xlat10_0.w
            * _Color.w + (-_Cutoff);\n    u_xlatb33 = u_xlat16_1<0.0;\n    if(u_xlatb33){discard;}\n   
