            u_xlat10_1 = textureCubeLodEXT(unity_SpecCube0, u_xlat16_10.xyz, u_xlat16_1);\n   
            u_xlat16_4.x = u_xlat10_1.w + -1.0;\n    u_xlat16_4.x = unity_SpecCube0_HDR.w
            * u_xlat16_4.x + 1.0;\n    u_xlat16_4.x = log2(u_xlat16_4.x);\n    u_xlat16_4.x
            = u_xlat16_4.x * unity_SpecCube0_HDR.y;\n    u_xlat16_4.x = exp2(u_xlat16_4.x);\n   
            u_xlat16_4.x = u_xlat16_4.x * unity_SpecCube0_HDR.x;\n    u_xlat16_4.xyz
            = u_xlat10_1.xyz * u_xlat16_4.xxx;\n    u_xlat10_27 = texture2D(_OcclusionMap,
            vs_TEXCOORD0.xy).y;\n    u_xlat16_4.xyz = vec3(u_xlat10_27) * u_xlat16_4.xyz;\n   
            u_xlat27 = dot((-vs_TEXCOORD1.xyz), u_xlat3.xyz);\n    u_xlat2.x = u_xlat27;\n   
            u_xlat2.x = clamp(u_xlat2.x, 0.0, 1.0);\n    u_xlat27 = u_xlat27 + u_xlat27;\n   
            u_xlat5.xyz = u_xlat3.xyz * (-vec3(u_xlat27)) + (-vs_TEXCOORD1.xyz);\n   
            u_xlat27 = dot(u_xlat3.xyz, _WorldSpaceLightPos0.xyz);\n    u_xlat27
            = clamp(u_xlat27, 0.0, 1.0);\n    u_xlat16_6.xyz = vec3(u_xlat27) * _LightColor0.xyz;\n   
            u_xlat27 = dot(u_xlat5.xyz, _WorldSpaceLightPos0.xyz);\n    u_xlat27
            = u_xlat27 * u_xlat27;\n    u_xlat2.y = u_xlat27 * u_xlat27;\n    u_xlat27
            = texture2D(unity_NHxRoughness, u_xlat2.yw).x;\n    u_xlat27 = u_xlat27
            * 16.0;\n    u_xlat16_31 = (-u_xlat2.x) + 1.0;\n    u_xlat2.x = u_xlat16_31
            * u_xlat16_31;\n    u_xlat2.x = u_xlat16_31 * u_xlat2.x;\n    u_xlat2.x
