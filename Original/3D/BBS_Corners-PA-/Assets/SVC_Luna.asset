            = u_xlat16_1.xyz * u_xlat16_4.xxx;\n    u_xlat16_27 = texture(_OcclusionMap,
            vs_TEXCOORD0.xy).y;\n    u_xlat16_4.xyz = vec3(u_xlat16_27) * u_xlat16_4.xyz;\n   
            u_xlat27 = dot((-vs_TEXCOORD1.xyz), u_xlat3.xyz);\n    u_xlat2.x = u_xlat27;\n   
            u_xlat2.x = clamp(u_xlat2.x, 0.0, 1.0);\n    u_xlat27 = u_xlat27 + u_xlat27;\n   
