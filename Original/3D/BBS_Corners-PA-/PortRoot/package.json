    "smoke:drag": "node scripts/drag-smoke.mjs",
    "smoke:framing": "node scripts/framing-smoke.mjs",
    "smoke:responsive": "node scripts/responsive-smoke.mjs",
    "smoke:full-clear": "node scripts/full-clear-smoke.mjs",
    "smoke:hints": "node scripts/hint-smoke.mjs",
    "smoke:iterations": "node scripts/iteration-smoke.mjs",
