{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arrow Flow level v1",
  "description": "Structural contract. Runtime validation additionally enforces cell uniqueness, contiguity, simple loop geometry, belt clearance and cannon placement. Inward bends are supported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "name",
    "origin",
    "board",
    "conveyor",
    "cannons"
  ],
  "properties": {
    "kind": {
      "const": "arrow-flow"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "minItems": 2,
      "maxItems": 2
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds",
        "arrows"
      ],
      "properties": {
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minX",
            "minY",
            "width",
            "height"
          ],
          "properties": {
            "minX": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "minY": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "color",
              "head",
              "body",
              "facing"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "color": {
                "enum": [
                  "green",
                  "blue",
                  "orange",
                  "black",
                  "pink",
                  "purple",
                  "yellow"
                ]
              },
              "head": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 2,
                "maxItems": 2
              },
              "body": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0,
                "maxItems": 500
              },
              "facing": {
                "enum": [
                  "Top",
                  "Right",
                  "Bottom",
                  "Left"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 500
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "offset"
          ],
          "properties": {
            "size": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.5
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "conveyor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points",
            "width",
            "direction"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3,
              "maxItems": 64
            },
            "width": {
              "type": "number",
              "minimum": 1.1,
              "maximum": 3
            },
            "direction": {
              "enum": [
                1,
                -1
              ]
            },
            "cornerRadius": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points",
            "width",
            "direction",
            "mesh"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3,
              "maxItems": 1024
            },
            "width": {
              "type": "number",
              "minimum": 1.1,
              "maximum": 3
            },
            "direction": {
              "enum": [
                1,
                -1
              ]
            },
            "mesh": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parts",
                "surface"
              ],
              "properties": {
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "position",
                      "normal",
                      "index"
                    ],
                    "properties": {
                      "position": {
                        "type": "string",
                        "maxLength": 1600000,
                        "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                      },
                      "normal": {
                        "type": "string",
                        "maxLength": 1600000,
                        "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                      },
                      "index": {
                        "type": "string",
                        "maxLength": 1600000,
                        "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                      }
                    }
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "surface": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": -1000,
                        "maximum": 1000
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 3,
                    "maxItems": 1024
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "cornerRadius": {
              "const": 0
            }
          }
        }
      ]
    },
    "cannons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "progress",
          "offset",
          "angle",
          "queue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          },
          "offset": {
            "type": "number",
            "minimum": 4,
            "maximum": 7
          },
          "angle": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            ]
          },
          "queue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color",
                "ammo"
              ],
              "properties": {
                "color": {
                  "enum": [
                    "green",
                    "blue",
                    "orange",
                    "black",
                    "pink",
                    "purple",
                    "yellow"
                  ]
                },
                "ammo": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                }
              }
            },
            "minItems": 1,
            "maxItems": 32
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "minItems": 0,
      "maxItems": 16
    }
  }
}
