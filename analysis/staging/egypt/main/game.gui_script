-- Egypt Case: original Phaser mechanics translated to Defold GUI/Lua.
-- Positions and motion remain in top-left authored 1080x1920 coordinates.
local ORDER = {"Aisha","Maya","Ahmose","Nefertiti","Merneptah","Khasekhemwy"}
local CHARACTER_SFX = {Ahmose="ahmose-sfx",Maya="maya-sfx",Merneptah="merneptah-sfx",Nefertiti="nefertiti-sfx"}
local function js(code)
    if html5 then return html5.run(code) end
end
local function bridge(method, data)
    return js("window.EgyptBridge && window.EgyptBridge."..method.."("..(data and json.encode(data) or "")..")")
end
local function event(name) bridge("event", name) end
local function audio(name) bridge("sound", name) end
local function pos(node,x,y) gui.set_position(node,vmath.vector3(x,1920-y,0)) end
local function alpha(node,a)
    local c=gui.get_color(node); c.w=a; gui.set_color(node,c)
end
local function enabled(node,value) gui.set_enabled(node,value) end
local function color(hex,a)
    return vmath.vector4(tonumber(hex:sub(2,3),16)/255,tonumber(hex:sub(4,5),16)/255,tonumber(hex:sub(6,7),16)/255,a or 1)
end
-- The HTML5 bridge decodes the original WebP with the browser and returns PNG.
-- This avoids shipping a large uncompressed atlas and preserves editable slots.
local B64={}; do local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"; for i=1,64 do B64[alphabet:sub(i,i)]=i-1 end end
local function decode64(s)
    return (s:gsub("....",function(c)
        local a,b,c2,d=B64[c:sub(1,1)] or 0,B64[c:sub(2,2)] or 0,B64[c:sub(3,3)] or 0,B64[c:sub(4,4)] or 0
        local n=a*262144+b*4096+c2*64+d
        local out=string.char(math.floor(n/65536)%256)
        if c:sub(3,3)~="=" then out=out..string.char(math.floor(n/256)%256) end
        if c:sub(4,4)~="=" then out=out..string.char(n%256) end
        return out
    end))
end
local function load_textures(self)
    for _,t in ipairs(self.c.CHANGABLE_TEXTURES) do
        local data
        if html5 then data=decode64(js("window.EgyptBridge.takeTexture("..json.encode(t.spriteName)..")"))
        else data=sys.load_resource("/assets/images/"..t.spriteName..".png") end
        local loaded=image.load(data)
        assert(loaded,"Could not decode original asset: "..t.spriteName)
        assert(gui.new_texture(t.spriteName,loaded.width,loaded.height,loaded.type,loaded.buffer,true),"Could not create texture: "..t.spriteName)
    end
end
local function box(self,key,x,y,w,h,tint)
    local n=gui.new_box_node(vmath.vector3(x,1920-y,0),vmath.vector3(w,h,0))
    gui.set_adjust_mode(n,gui.ADJUST_MODE_FIT)
    if key then gui.set_texture(n,key) end
    if tint then gui.set_color(n,tint) end
    return n
end
local function text(self,label,x,y,size,tint,font)
    local n=gui.new_text_node(vmath.vector3(x,1920-y,0),label)
    gui.set_font(n,font or "body"); gui.set_color(n,color(tint))
    gui.set_scale(n,vmath.vector3(size/80,size/80,1))
    gui.set_adjust_mode(n,gui.ADJUST_MODE_FIT)
    return n
end
local function texture(self,key)
    for _,t in ipairs(self.c.CHANGABLE_TEXTURES) do if t.spriteName==key then return t end end
end
local function image_size(self,node,key,w,h)
    local t=texture(self,key)
    if not t.resizeBlocked then w=t.originalSize.width; h=t.originalSize.height end
    gui.set_size(node,vmath.vector3(w*t.scale,h*t.scale,0))
end
local function portrait_size(self,item)
    local t=texture(self,item.name)
    local h=item.placed and self.c.PLACED_CHARACTER_HEIGHT or self.c.CHARACTER_HEIGHT
    if not t.resizeBlocked then h=t.originalSize.height end
    h=h*t.scale
    gui.set_size(item.node,vmath.vector3(h*t.originalSize.width/t.originalSize.height,h,0))
end
local function home(self,i)
    return self.c.CHARACTER_LIST_MARGIN_X+(1080-2*self.c.CHARACTER_LIST_MARGIN_X)/6*(i-.5),self.c.CHARACTER_HOME_Y
end
local function ease_back(t) local c=1.70158; return 1+(c+1)*(t-1)^3+c*(t-1)^2 end
local function sine(t) return (1-math.cos(t*math.pi))/2 end
local function move(item,x,y,ms)
    item.motion={x=item.x,y=item.y,tox=x,toy=y,t=0,d=ms/1000}
end
local function publish_state(self)
    local placed={}; local positions={}
    for _,item in ipairs(self.items) do
        placed[item.name]=item.placed; positions[item.name]={x=item.x,y=item.y,moving=item.motion~=nil}
    end
    bridge("state",{solved=self.solved,presses=self.presses,finished=self.finished,endcard=self.endcard,
        tutorial=self.tutorial,placed=placed,positions=positions,elapsed=self.elapsed})
end
local function redirect(self)
    if not self.cta_recorded then event("CTA_CLICKED"); self.cta_recorded=true end
    bridge("redirect")
end
local function show_endcard(self)
    if self.endcard or not self.c.SHOW_PACKSHOT then return end
    self.endcard=true; self.endtime=0
    enabled(self.overlay,true); enabled(self.logo,true)
    event("ENDCARD_SHOWN"); audio("endcard"); bridge("endcard"); redirect(self)
end
local function complete(self,solved,immediate)
    if self.finished then return end
    self.finished=true; self.drag=nil; self.tutorial="hidden"
    if solved then event("CHALLENGE_SOLVED") end
    bridge("lifecycle","gameEnd")
    if immediate then show_endcard(self) else self.enddelay=self.c.TIMING.completionDelayMs/1000 end
end
local function activity(self)
    if self.tutorial~="hidden" then self.tutorial_fade=self.c.TUTORIAL.fadeMs/1000 end
    self.tutorial="hidden"; self.idle=0
    bridge("unlock")
end
local function choose_idle(self)
    local choices={}
    for _,item in ipairs(self.items) do if not item.placed and item.name~="Aisha" then choices[#choices+1]=item end end
    if #choices==0 then for _,item in ipairs(self.items) do if not item.placed then choices[#choices+1]=item end end end
    if #choices==0 then return end
    self.hint=choices[self.idle_index % #choices+1]; self.idle_index=self.idle_index+1
    self.tutorial="idle"; self.tt=0
end
local function tutorial_segment(segments,t)
    for _,s in ipairs(segments) do
        if t<=s[1] then return s[2],t/s[1] end
        t=t-s[1]
    end
    return "done",1
end
local function update_tutorial(self,dt)
    local cfg=self.c.TUTORIAL; local f=cfg.fadeMs/1000; local d=cfg.stepDelayMs/1000; local m=cfg.moveMs/1000
    local visible=self.tutorial~="hidden" or self.tutorial_fade~=nil
    for _,n in ipairs(self.tutorial_nodes) do enabled(n,visible) end
    if not visible then return end
    if self.tutorial=="hidden" then
        self.tutorial_fade=math.max(0,self.tutorial_fade-dt)
        local factor=self.tutorial_fade/f
        for _,n in ipairs(self.tutorial_nodes) do alpha(n,(self.tutorial_alphas[n] or 0)*factor) end
        if self.tutorial_fade<=0 then self.tutorial_fade=nil end
        return
    end
    self.tt=self.tt+dt
    local hint=self.hint; local hx,hy=home(self,hint.index); local target=self.c.DROP_POSITIONS[hint.name]
    local x,y,progress,hs,ha,pa=hx,hy,0,1,1,0
    local opening=self.tutorial=="opening"
    local intro=d+f+d+m+d+m
    local t=self.tt
    if opening and t<intro then
        local phase,p=tutorial_segment({{d,"wait"},{f,"fade"},{d,"wait2"},{m,"sweep"},{d,"wait3"},{m,"tohome"}},t)
        x,y=self.highlight.left,self.highlight.bottom+cfg.highlightPaddingY
        ha=phase=="wait" and 0 or phase=="fade" and p or 1
        if phase=="sweep" then x=self.highlight.left+(self.highlight.right-self.highlight.left)*sine(p)
        elseif phase=="wait3" then x=self.highlight.right
        elseif phase=="tohome" then x=self.highlight.right+(hx-self.highlight.right)*sine(p); y=y+(hy-y)*sine(p) end
    else
        if opening then t=t-intro end
        local cycle= opening and (f+d+f+d+m+f+2*d+f+f+d) or (f+d+f+m+f+2*d+f+d)
        t=t%cycle
        local seg=opening and {{f,"fade"},{d,"wait"},{f,"press"},{d,"hold"},{m,"drag"},{f,"release"},{2*d,"endhold"},{f,"out"},{f,"reset"},{d,"resetwait"}}
            or {{f,"fade"},{d,"wait"},{f,"press"},{m,"drag"},{f,"release"},{2*d,"endhold"},{f,"out"},{d,"resetwait"}}
        local phase,p=tutorial_segment(seg,t)
        if phase=="fade" then ha=p; pa=p
        elseif phase=="press" then hs=1+(cfg.pressScale-1)*p
        elseif phase=="hold" then hs=cfg.pressScale
        elseif phase=="drag" then progress=sine(p); hs=cfg.pressScale
        elseif phase=="release" then progress=1; hs=cfg.pressScale+(1-cfg.pressScale)*p
        elseif phase=="endhold" then progress=1
        elseif phase=="out" then progress=1; ha=1-p
        elseif phase=="reset" then ha=0; pa=p
        elseif phase=="resetwait" then ha=0 end
        if phase~="fade" and phase~="reset" then pa=ha end
        x=hx+(target.x-hx)*progress; y=hy+(target.y-hy)*progress
    end
    local strength=math.min(1,self.tt/f)
    for _,n in ipairs(self.dim) do enabled(n,opening); alpha(n,cfg.overlayAlpha*strength) end
    for _,n in ipairs({self.ghost,self.ghostcircle,self.prompt}) do enabled(n,opening) end
    gui.set_texture(self.ghost,hint.name); gui.set_texture(self.prompt,hint.name)
    local tex=texture(self,hint.name); local ph=self.c.CHARACTER_HEIGHT*tex.scale
    for _,n in ipairs({self.ghost,self.prompt}) do gui.set_size(n,vmath.vector3(ph*tex.originalSize.width/tex.originalSize.height,ph,0)) end
    pos(self.ghost,hx,hy); pos(self.ghostcircle,target.x,target.y)
    pos(self.prompt,hx+(target.x-hx)*progress,hy+(target.y-hy)*progress)
    alpha(self.ghost,cfg.ghostAlpha*strength); alpha(self.ghostcircle,cfg.ghostAlpha*strength); alpha(self.prompt,pa)
    local hand=texture(self,"tutorial-hand"); local width=cfg.handWidth*hand.scale*hs
    -- Defold boxes are centered; translate the original noncentral hand origin.
    pos(self.hand,x+width*(.5-hand.anchorPoint.x),y+width*(.5-hand.anchorPoint.y))
    gui.set_size(self.hand,vmath.vector3(width,width,0)); alpha(self.hand,ha)
    for _,n in ipairs(self.tutorial_nodes) do self.tutorial_alphas[n]=gui.get_color(n).w end
end

function init(self)
    msg.post(".","acquire_input_focus")
    self.c=json.decode(sys.load_resource("/config/defaults.json"))
    local browser=js("JSON.stringify(window.EgyptBridge ? window.EgyptBridge.config : null)")
    if browser and browser~="null" and browser~="" then self.c=json.decode(browser) end
    load_textures(self)
    local c=self.c
    self.elapsed=0; self.solved=0; self.presses=0; self.progress=1; self.idle=0; self.idle_index=0; self.finished=false; self.endcard=false
    self.tutorial=c.HAND_TUTOR_MODE and "opening" or "hidden"; self.tt=0; self.tutorial_alphas={}
    self.bg=box(self,nil,540,960,1080,1920,vmath.vector4(c.GAME_BACKGROUND_COLOR[1]/255,c.GAME_BACKGROUND_COLOR[2]/255,c.GAME_BACKGROUND_COLOR[3]/255,1))
    for _,entry in ipairs({{"map-bg",c.LAYOUT.map},{"character-bg",c.LAYOUT.characters},{"clue-bg",c.LAYOUT.clues}}) do
        local r=entry[2]; local n=box(self,entry[1],r.x+r.width/2,r.y+r.height/2,r.width,r.height); image_size(self,n,entry[1],r.width,r.height)
    end
    self.targets={}; self.items={}; self.rows={}
    for i,name in ipairs(ORDER) do
        local p=c.DROP_POSITIONS[name]; local n=box(self,"drop-circle",p.x,p.y,c.DROP_CIRCLE_SIZE,c.DROP_CIRCLE_SIZE)
        image_size(self,n,"drop-circle",c.DROP_CIRCLE_SIZE,c.DROP_CIRCLE_SIZE); self.targets[name]=n
    end
    for i,name in ipairs(ORDER) do
        local x,y=home(self,i); local item={name=name,index=i,x=x,y=y,placed=false,node=box(self,name,x,y,1,1)}
        portrait_size(self,item); self.items[i]=item
        if name==c.TUTORIAL.openingCharacter then self.hint=item end
    end
    self.title=text(self,c.CLUE_TITLE,540,c.CLUE_LAYOUT.titleY,c.CLUE_LAYOUT.titleFontSize,c.COLORS.title,"title")
    for i,clue in ipairs(c.CLUES) do
        local n=text(self,clue.text,540,c.CLUE_LAYOUT.clueYPositions[i],c.CLUE_LAYOUT.clueFontSize,c.COLORS.clue)
        local metrics=gui.get_text_metrics_from_node(n)
        local width=metrics.width*c.CLUE_LAYOUT.clueFontSize/80
        local strike=box(self,nil,540-width/2,c.CLUE_LAYOUT.clueYPositions[i],0,4,color(c.COLORS.strike))
        gui.set_pivot(strike,gui.PIVOT_W)
        self.rows[clue.character]={node=n,strike=strike,width=width,progress=0}
    end
    local tm=gui.get_text_metrics_from_node(self.title)
    local fm=gui.get_text_metrics_from_node(self.rows[c.CLUES[1].character].node)
    local tw=tm.width*c.CLUE_LAYOUT.titleFontSize/80; local fw=fm.width*c.CLUE_LAYOUT.clueFontSize/80
    self.highlight={left=540-math.max(tw,fw)/2,right=540+math.max(tw,fw)/2,top=c.CLUE_LAYOUT.titleY-c.CLUE_LAYOUT.titleFontSize/2,bottom=c.CLUE_LAYOUT.clueYPositions[1]+c.CLUE_LAYOUT.clueFontSize/2}
    local hi=self.highlight; local px=c.TUTORIAL.highlightPaddingX; local py=c.TUTORIAL.highlightPaddingY
    local left,right,top,bottom=hi.left-px,hi.right+px,hi.top-py,hi.bottom+py
    self.dim={box(self,nil,540,top/2,1080,top,color(c.COLORS.overlay,0)),box(self,nil,540,(bottom+1920)/2,1080,1920-bottom,color(c.COLORS.overlay,0)),box(self,nil,left/2,(top+bottom)/2,left,bottom-top,color(c.COLORS.overlay,0)),box(self,nil,(right+1080)/2,(top+bottom)/2,1080-right,bottom-top,color(c.COLORS.overlay,0))}
    self.ghost=box(self,self.hint.name,0,0,1,1); self.ghostcircle=box(self,"drop-circle",0,0,c.DROP_CIRCLE_SIZE,c.DROP_CIRCLE_SIZE)
    self.prompt=box(self,self.hint.name,0,0,1,1); self.hand=box(self,"tutorial-hand",0,0,200,200)
    self.tutorial_nodes={self.dim[1],self.dim[2],self.dim[3],self.dim[4],self.ghost,self.ghostcircle,self.prompt,self.hand}
    self.overlay=box(self,nil,540,960,1080,1920,color(c.COLORS.overlay,0)); enabled(self.overlay,false)
    self.error=box(self,"error",540,960,1080,1920); enabled(self.error,false)
    self.logo=box(self,"logo",540,960,1,1); enabled(self.logo,false)
    event("LOADED"); event("DISPLAYED"); bridge("lifecycle","gameStart"); event("CHALLENGE_STARTED")
    update_tutorial(self,0); publish_state(self)
end

function update(self,dt)
    if bridge("paused")=="true" then return end
    self.elapsed=self.elapsed+dt; self.idle=self.idle+dt
    for _,item in ipairs(self.items) do
        if item.motion then
            local m=item.motion; m.t=math.min(m.d,m.t+dt); local p=ease_back(m.t/m.d)
            item.x=m.x+(m.tox-m.x)*p; item.y=m.y+(m.toy-m.y)*p
            pos(item.node,item.x,item.y)
            if m.t>=m.d then item.motion=nil end
        end
    end
    for _,row in pairs(self.rows) do
        if row.solved then row.progress=math.min(1,row.progress+dt/(self.c.TIMING.snapMs/1000)); gui.set_size(row.strike,vmath.vector3(row.width*(1-(1-row.progress)^3),4,0)) end
    end
    if self.hover then self.spin=(self.spin or 0)+dt*360/(self.c.TIMING.dropCircleSpinMs/1000); gui.set_rotation(self.targets[self.hover],vmath.quat_rotation_z(-math.rad(self.spin))) end
    if self.error_time then
        self.error_time=self.error_time+dt
        local d=self.c.TIMING.errorBlinkMs/1000
        alpha(self.error,.78*(1-math.cos(self.error_time/d*math.pi))/2)
        if self.error_time>=d*4 then enabled(self.error,false); self.error_time=nil end
    end
    if not self.finished and self.c.HAND_TUTOR_MODE and self.idle>=self.c.TUTORIAL_DELAY and self.tutorial=="hidden" and not self.tutorial_fade then choose_idle(self) end
    update_tutorial(self,dt)
    if self.enddelay then self.enddelay=self.enddelay-dt; if self.enddelay<=0 then self.enddelay=nil; show_endcard(self) end end
    if self.endcard then
        self.endtime=self.endtime+dt; local t=self.endtime; local timing=self.c.TIMING
        alpha(self.overlay,.72*math.min(1,t/(timing.overlayFadeMs/1000))); alpha(self.logo,math.min(1,t/(timing.logoFadeMs/1000)))
        local d=timing.logoScaleMs/1000; local scale
        if t<d then scale=.9+.1*ease_back(t/d) else scale=1+.06*(1-math.cos((t-d)/(timing.logoPulseMs/1000)*math.pi))/2 end
        local tex=texture(self,"logo"); local width=self.c.LOGO_WIDTH*tex.scale*scale
        gui.set_size(self.logo,vmath.vector3(width,width*tex.originalSize.height/tex.originalSize.width,0))
    end
    local w,h=window.get_size(); local s=math.min(w/1080,h/1920); local vw,vh=w/s,h/s
    gui.set_size(self.bg,vmath.vector3(vw,vh,0)); gui.set_size(self.overlay,vmath.vector3(vw,vh,0)); gui.set_size(self.error,vmath.vector3(vw,vh,0))
    -- Extend the four tutorial masks over the letterboxed margins as well.
    if self.tutorial=="opening" then
        local hi=self.highlight; local px=self.c.TUTORIAL.highlightPaddingX; local py=self.c.TUTORIAL.highlightPaddingY
        local l,r,t,b=hi.left-px,hi.right+px,hi.top-py,hi.bottom+py
        local minx,maxx,miny,maxy=(1080-vw)/2,(1080+vw)/2,(1920-vh)/2,(1920+vh)/2
        local rects={{(minx+maxx)/2,(miny+t)/2,vw,t-miny},{540,(b+maxy)/2,vw,maxy-b},{(minx+l)/2,(t+b)/2,l-minx,b-t},{(r+maxx)/2,(t+b)/2,maxx-r,b-t}}
        for i,rct in ipairs(rects) do pos(self.dim[i],rct[1],rct[2]); gui.set_size(self.dim[i],vmath.vector3(rct[3],rct[4],0)) end
    end
    publish_state(self)
end

function on_input(self,action_id,action)
    if action_id~=hash("touch") then return end
    if bridge("paused")=="true" then return true end
    local w,h=window.get_size(); local s=math.min(w/1080,h/1920)
    local ax=action.screen_x or action.x*w/1080
    local ay=action.screen_y or action.y*h/1920
    local x=(ax-(w-1080*s)/2)/s; local y=1920-(ay-(h-1920*s)/2)/s
    if action.pressed then
        if self.endcard then redirect(self); return true end
        if self.finished then return true end
        activity(self)
        for i=#self.items,1,-1 do
            local item=self.items[i]; local size=gui.get_size(item.node)
            if not item.placed and not item.motion and math.abs(x-item.x)<=size.x/2 and math.abs(y-item.y)<=size.y/2 then
                self.presses=self.presses+1; audio("pick-drop-character")
                if self.c.GAME_LENGTH.clickLimit<9999 and self.presses>=self.c.GAME_LENGTH.clickLimit then complete(self,false,true); return true end
                self.drag=item; self.dx=item.x-x; self.dy=item.y-y; gui.move_above(item.node,self.items[#self.items].node)
                break
            end
        end
    end
    if self.drag then
        local item=self.drag; item.x=x+self.dx; item.y=y+self.dy; pos(item.node,item.x,item.y)
        if self.hover then gui.set_rotation(self.targets[self.hover],vmath.quat()); self.hover=nil end
        for _,name in ipairs(ORDER) do
            local p=self.c.DROP_POSITIONS[name]
            if not self.rows[name].solved and (item.x-p.x)^2+(item.y-p.y)^2<=self.c.DROP_RADIUS^2 then self.hover=name; break end
        end
        if action.released then
            audio("pick-drop-character"); self.drag=nil
            if self.hover then gui.set_rotation(self.targets[self.hover],vmath.quat()); self.hover=nil end
            local p=self.c.DROP_POSITIONS[item.name]
            if (item.x-p.x)^2+(item.y-p.y)^2<=self.c.DROP_RADIUS^2 then
                item.placed=true; enabled(self.targets[item.name],false); self.rows[item.name].solved=true; self.solved=self.solved+1
                portrait_size(self,item); move(item,p.x,p.y,self.c.TIMING.snapMs)
                audio("red-strike"); audio("correct"); if CHARACTER_SFX[item.name] then audio(CHARACTER_SFX[item.name]) end
                local milestones={25,50,75}
                while self.progress<=3 and self.solved/6*100>=milestones[self.progress] do event("CHALLENGE_PASS_"..milestones[self.progress]); self.progress=self.progress+1 end
                if self.solved==6 then complete(self,true,false) end
            else
                local wrong=false
                for _,name in ipairs(ORDER) do local p2=self.c.DROP_POSITIONS[name]; if name~=item.name and (item.x-p2.x)^2+(item.y-p2.y)^2<=self.c.DROP_RADIUS^2 then wrong=true end end
                if wrong then audio("wrong"); self.error_time=0; enabled(self.error,true) end
                audio("return"); local hx,hy=home(self,item.index); move(item,hx,hy,self.c.TIMING.returnMs)
            end
        end
    end
    publish_state(self)
    return true
end
