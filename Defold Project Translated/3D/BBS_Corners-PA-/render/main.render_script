local viewport = require "main.viewport"
function init(self)
    self.world = render.predicate({"world"})
    self.gui = render.predicate({"gui"})
    self.text = render.predicate({"text"})
end
function update(self)
    local w,h = render.get_window_width(),render.get_window_height()
    if w < 1 or h < 1 then return end
    local v = viewport.calculate(w,h)
    render.set_depth_mask(true)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(0.8039,0.8824,0.9451,1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1,[graphics.BUFFER_TYPE_STENCIL_BIT]=0})
    render.set_viewport(0,v.footer,w,v.available)
    render.set_view(v.view)
    render.set_projection(v.projection)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_func(graphics.COMPARE_FUNC_LEQUAL)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.disable_state(graphics.STATE_BLEND)
    render.draw(self.world)
    render.set_viewport(0,0,w,h)
    render.set_view(vmath.matrix4())
    render.set_projection(vmath.matrix4_orthographic(0,w,0,h,-1,1))
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_mask(false)
    render.enable_state(graphics.STATE_BLEND)
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_state(graphics.STATE_STENCIL_TEST)
    render.draw(self.gui)
    render.draw(self.text)
    render.disable_state(graphics.STATE_STENCIL_TEST)
end
