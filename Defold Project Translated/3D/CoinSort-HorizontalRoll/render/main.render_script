function init(self)
    self.bg=render.predicate({'bg'})
    self.coin=render.predicate({'coin'})
    self.jarbase=render.predicate({'jarbase'})
    self.gui=render.predicate({'gui'})
    self.constants=render.constant_buffer()
    self.constants.camera=vmath.vector4(540,960,1.5,0)
    self.constants.clock=vmath.vector4(0,0,0,0)
    self.constants.jar=vmath.vector4(540,745,0,0)
    self.shadow=render.render_target('coin_shadow',{
        [graphics.BUFFER_TYPE_COLOR0_BIT]={format=graphics.TEXTURE_FORMAT_RGBA,width=2048,height=2048,min_filter=graphics.TEXTURE_FILTER_NEAREST,mag_filter=graphics.TEXTURE_FILTER_NEAREST,u_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE},
        [graphics.BUFFER_TYPE_DEPTH_BIT]={format=graphics.TEXTURE_FORMAT_DEPTH,width=2048,height=2048}
    })
end
function update(self,dt)
    local w,h=render.get_window_width(),render.get_window_height()
    if w<1 or h<1 then return end
    local s=math.min(w/1080,h/1920)
    self.constants.viewport=vmath.vector4(w,h,s,0)
    local light=vmath.vector3(w/2-600,h/2-600,9000)
    local target=light+vmath.vector3(2272.389,2352.55,-8480.669)
    local half=math.max(w,h)/2+900
    self.constants.light_view_proj=vmath.matrix4_orthographic(-half,half,-half,half,.5,20000)*vmath.matrix4_look_at(light,target,vmath.vector3(0,1,0))
    render.set_render_target(self.shadow)
    render.set_viewport(0,0,2048,2048)
    render.set_depth_mask(true)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_func(graphics.COMPARE_FUNC_LEQUAL)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_cull_face(graphics.FACE_TYPE_FRONT)
    render.disable_state(graphics.STATE_BLEND)
    render.enable_material('shadow')
    local shadow_clock=self.constants.clock
    shadow_clock.w=1;shadow_clock.y=0;self.constants.clock=shadow_clock
    render.draw(self.coin,{constants=self.constants})
    if self.jar_visible then shadow_clock.y=1;self.constants.clock=shadow_clock;render.draw(self.coin,{constants=self.constants})end
    render.disable_material()
    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.enable_texture(1,self.shadow,graphics.BUFFER_TYPE_COLOR0_BIT)
    shadow_clock.w=0;self.constants.clock=shadow_clock
    render.set_viewport(0,0,w,h)
    render.set_depth_mask(true)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(3/255,20/255,37/255,1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1,[graphics.BUFFER_TYPE_STENCIL_BIT]=0})
    render.set_view(vmath.matrix4())
    render.set_projection(vmath.matrix4_orthographic(0,w,0,h,-1,1))
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.enable_state(graphics.STATE_BLEND)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.bg)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_func(graphics.COMPARE_FUNC_LEQUAL)
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_cull_face(graphics.FACE_TYPE_BACK)
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    local clock=self.constants.clock
    clock.y=0;self.constants.clock=clock
    render.draw(self.coin,{constants=self.constants})
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.jarbase)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    clock.y=1;self.constants.clock=clock
    if self.jar_visible then render.draw(self.coin,{constants=self.constants})end
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.enable_state(graphics.STATE_STENCIL_TEST)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.gui)
    render.disable_state(graphics.STATE_STENCIL_TEST)
    render.disable_texture(1)
    self.frames=(self.frames or 0)+1
    self.report_time=(self.report_time or 0)+(dt or 1/60)
    if self.report_time>=.25 then
        self.report_time=0
        msg.post('main:/game#script','frame_presented',{frames=self.frames})
    end
end
function on_message(self,id,m)
    if id==hash('frame')then
        self.constants.camera=vmath.vector4(m.x,m.y,m.zoom,0)
        self.constants.clock=vmath.vector4(m.time,0,m.first_fill,0)
        self.constants.jar=vmath.vector4(m.jar_x,m.jar_y,m.jar_visible and 1 or 0,0)
        self.jar_visible=m.jar_visible
    end
end
